# Copy to .env (gitignored). Bun loads it automatically.

# Tunnel server (reverse-proxy / kcgcode-rp) used by Settings → Remote access.
# In development this enables the feature; on `bun publish` / `bun pm pack` it's
# baked into the package (must be https://). Example:
# KCG_TUNNEL_API_URL=https://kcgcode.example.com
KCG_TUNNEL_API_URL=
TUNNEL_DOMAIN=
