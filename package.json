{
  "name": "kcgcode",
  "version": "0.1.0",
  "description": "Control CLI AI agents (OpenCode / Claude Code) from your phone — mobile PWA + local headless bridge.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kcgcode": "./bin/kcgcode.ts"
  },
  "files": [
    "bin",
    "src",
    "public",
    "styles",
    "bun-env.d.ts",
    "tsconfig.json",
    "README.md",
    "kcg-code.config.example.json"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "bun",
    "cli",
    "tui",
    "opencode",
    "claude-code",
    "ai-agent",
    "pwa",
    "mobile"
  ],
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "kcgcode": "bun bin/kcgcode.ts",
    "build": "bun run build.ts",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "bun scripts/stamp-build-config.ts",
    "postpack": "bun scripts/stamp-build-config.ts --reset"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@shadcn/react": "^0.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "ink": "^7.1.1",
    "lucide-react": "^1",
    "motion": "13.4.6",
    "picocolors": "^1.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "fast-check": "^4.9.0",
    "react-reconciler": "0.33.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^6"
  },
  "peerDependencies": {
    "typescript": "^6"
  }
}
